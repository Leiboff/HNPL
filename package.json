{
  "name": "hnpl",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm run typecheck && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsx scripts/clean-next-types.mts && tsc --noEmit",
    "test": "vitest run",
    "test:fraud": "vitest run supabase/migrations/0142_fraud_risk_controls.rpc.test.ts lib/risk/*.test.ts app/risk-wiring.test.ts lib/payments/runPayoutBatches.pglite.test.ts --no-file-parallelism",
    "test:watch": "vitest",
    "test:preauth": "tsx --env-file=.env.local scripts/test-preauth.ts",
    "test:crm-conversion": "tsx --env-file=.env.local scripts/test-crm-conversion.ts",
    "audit:default-mismatch": "tsx --env-file=.env.local scripts/audit-card-default-mismatch.ts",
    "check:rls-drift": "tsx --env-file=.env.local scripts/check-rls-drift.ts",
    "design-sync:css": "pnpm --package=@tailwindcss/cli@4.3.0 dlx tailwindcss -i .design-sync/ds-input.css -o .design-sync/ds.css",
    "prepare": "simple-git-hooks || true",
    "test:serial": "vitest run --no-file-parallelism"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm run typecheck"
  },
  "dependencies": {
    "@googlemaps/markerclusterer": "^2.6.2",
    "@simplewebauthn/browser": "^13.3.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.0",
    "jsqr": "^1.4.0",
    "next": "16.2.11",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "happy-dom": "^20.10.2",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vite": "^8.0.16",
    "vitest": "^4.1.6"
  },
  "packageManager": "pnpm@11.1.3"
}
